{
  "name": "task-manager-api",
  "version": "1.0.0",
  "description": "Task management REST API built with Express, TypeScript, MongoDB and Zod",
  "main": "dist/main.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node build/main.js",
    "start:dev": "npx tsc-watch --onSuccess \"npm start\"",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs"
  },
  "keywords": [
    "typescript",
    "express",
    "mongodb",
    "mongoose",
    "rest-api",
    "task-manager"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
